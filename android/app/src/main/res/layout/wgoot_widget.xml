<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/wgoot_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/wgoot_widget_background"
    android:layoutDirection="rtl"
    android:orientation="vertical"
    android:padding="14dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:baselineAligned="false"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/wgoot_city"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:ellipsize="end"
            android:fontFamily="@font/wgoot_sans"
            android:maxLines="1"
            android:text="مكة المكرمة"
            android:textColor="@color/wgoot_widget_gold"
            android:textSize="12sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/wgoot_hijri"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:ellipsize="end"
            android:fontFamily="@font/wgoot_sans"
            android:maxLines="1"
            android:text="٢١ صفر ١٤٤٨ هـ"
            android:textColor="@color/wgoot_widget_muted"
            android:textSize="11sp" />
    </LinearLayout>

    <LinearLayout
        android:id="@+id/wgoot_hero"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:baselineAligned="false"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingTop="8dp">

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:id="@+id/wgoot_next_title"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:ellipsize="end"
                android:fontFamily="@font/wgoot_sans"
                android:maxLines="1"
                android:text="الفجر"
                android:textColor="@color/wgoot_widget_text"
                android:textSize="21sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/wgoot_next_clock"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:ellipsize="end"
                android:fontFamily="@font/wgoot_sans"
                android:maxLines="1"
                android:text="٤:١٥ ص"
                android:textColor="@color/wgoot_widget_gold"
                android:textSize="13sp" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/wgoot_countdown_block"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:gravity="end"
            android:orientation="vertical">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="@font/wgoot_sans"
                android:text="@string/wgoot_widget_remaining"
                android:textColor="@color/wgoot_widget_muted"
                android:textSize="10sp" />

            <Chronometer
                android:id="@+id/wgoot_countdown"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="@font/wgoot_sans"
                android:layoutDirection="ltr"
                android:text="01:23:45"
                android:textColor="@color/wgoot_widget_gold"
                android:textSize="20sp"
                android:textStyle="bold" />
        </LinearLayout>
    </LinearLayout>

    <TextView
        android:id="@+id/wgoot_empty"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:fontFamily="@font/wgoot_sans"
        android:gravity="center"
        android:paddingTop="10dp"
        android:text="@string/wgoot_widget_empty"
        android:textColor="@color/wgoot_widget_muted"
        android:textSize="12sp"
        android:visibility="gone" />

    <LinearLayout
        android:id="@+id/wgoot_grid"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:baselineAligned="false"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingTop="10dp">

        <LinearLayout
            android:id="@+id/wgoot_slot_0"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:gravity="center"
            android:orientation="vertical"
            android:paddingTop="5dp"
            android:paddingBottom="5dp">

            <TextView
                android:id="@+id/wgoot_slot_0_title"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="@font/wgoot_sans"
                android:maxLines="1"
                android:text="الفجر"
                android:textColor="@color/wgoot_widget_muted"
                android:textSize="10sp" />

            <TextView
                android:id="@+id/wgoot_slot_0_clock"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="@font/wgoot_sans"
                android:maxLines="1"
                android:text="٤:١٥"
                android:textColor="@color/wgoot_widget_text"
                android:textSize="12sp"
                android:textStyle="bold" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/wgoot_slot_1"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:gravity="center"
            android:orientation="vertical"
            android:paddingTop="5dp"
            android:paddingBottom="5dp">

            <TextView
                android:id="@+id/wgoot_slot_1_title"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="@font/wgoot_sans"
                android:maxLines="1"
                android:text="الشروق"
                android:textColor="@color/wgoot_widget_muted"
                android:textSize="10sp" />

            <TextView
                android:id="@+id/wgoot_slot_1_clock"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="@font/wgoot_sans"
                android:maxLines="1"
                android:text="٥:٤٠"
                android:textColor="@color/wgoot_widget_text"
                android:textSize="12sp"
                android:textStyle="bold" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/wgoot_slot_2"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:gravity="center"
            android:orientation="vertical"
            android:paddingTop="5dp"
            android:paddingBottom="5dp">

            <TextView
                android:id="@+id/wgoot_slot_2_title"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="@font/wgoot_sans"
                android:maxLines="1"
                android:text="الظهر"
                android:textColor="@color/wgoot_widget_muted"
                android:textSize="10sp" />

            <TextView
                android:id="@+id/wgoot_slot_2_clock"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="@font/wgoot_sans"
                android:maxLines="1"
                android:text="١٢:٢٠"
                android:textColor="@color/wgoot_widget_text"
                android:textSize="12sp"
                android:textStyle="bold" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/wgoot_slot_3"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:gravity="center"
            android:orientation="vertical"
            android:paddingTop="5dp"
            android:paddingBottom="5dp">

            <TextView
                android:id="@+id/wgoot_slot_3_title"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="@font/wgoot_sans"
                android:maxLines="1"
                android:text="العصر"
                android:textColor="@color/wgoot_widget_muted"
                android:textSize="10sp" />

            <TextView
                android:id="@+id/wgoot_slot_3_clock"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="@font/wgoot_sans"
                android:maxLines="1"
                android:text="٣:٤٥"
                android:textColor="@color/wgoot_widget_text"
                android:textSize="12sp"
                android:textStyle="bold" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/wgoot_slot_4"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:gravity="center"
            android:orientation="vertical"
            android:paddingTop="5dp"
            android:paddingBottom="5dp">

            <TextView
                android:id="@+id/wgoot_slot_4_title"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="@font/wgoot_sans"
                android:maxLines="1"
                android:text="المغرب"
                android:textColor="@color/wgoot_widget_muted"
                android:textSize="10sp" />

            <TextView
                android:id="@+id/wgoot_slot_4_clock"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="@font/wgoot_sans"
                android:maxLines="1"
                android:text="٦:٥٥"
                android:textColor="@color/wgoot_widget_text"
                android:textSize="12sp"
                android:textStyle="bold" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/wgoot_slot_5"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:gravity="center"
            android:orientation="vertical"
            android:paddingTop="5dp"
            android:paddingBottom="5dp">

            <TextView
                android:id="@+id/wgoot_slot_5_title"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="@font/wgoot_sans"
                android:maxLines="1"
                android:text="العشاء"
                android:textColor="@color/wgoot_widget_muted"
                android:textSize="10sp" />

            <TextView
                android:id="@+id/wgoot_slot_5_clock"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="@font/wgoot_sans"
                android:maxLines="1"
                android:text="٨:٢٥"
                android:textColor="@color/wgoot_widget_text"
                android:textSize="12sp"
                android:textStyle="bold" />
        </LinearLayout>
    </LinearLayout>
</LinearLayout>
