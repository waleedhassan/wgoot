<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/wgoot_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/wgoot_widget_background"
    android:baselineAligned="false"
    android:gravity="center_vertical"
    android:layoutDirection="rtl"
    android:orientation="horizontal"
    android:padding="12dp">

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:orientation="vertical">

        <TextView
            android:id="@+id/wgoot_city"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:ellipsize="end"
            android:fontFamily="@font/wgoot_sans"
            android:maxLines="1"
            android:text="مكة المكرمة"
            android:textColor="@color/wgoot_widget_gold"
            android:textSize="11sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/wgoot_next_title"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:ellipsize="end"
            android:fontFamily="@font/wgoot_sans"
            android:maxLines="1"
            android:text="الفجر"
            android:textColor="@color/wgoot_widget_text"
            android:textSize="19sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/wgoot_next_clock"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:ellipsize="end"
            android:fontFamily="@font/wgoot_sans"
            android:maxLines="1"
            android:text="٤:١٥ ص"
            android:textColor="@color/wgoot_widget_muted"
            android:textSize="12sp" />
    </LinearLayout>

    <LinearLayout
        android:id="@+id/wgoot_countdown_block"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="6dp"
        android:gravity="end"
        android:orientation="vertical">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:fontFamily="@font/wgoot_sans"
            android:text="@string/wgoot_widget_remaining"
            android:textColor="@color/wgoot_widget_muted"
            android:textSize="10sp" />

        <Chronometer
            android:id="@+id/wgoot_countdown"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:fontFamily="@font/wgoot_sans"
            android:layoutDirection="ltr"
            android:text="01:23:45"
            android:textColor="@color/wgoot_widget_gold"
            android:textSize="18sp"
            android:textStyle="bold" />
    </LinearLayout>

    <TextView
        android:id="@+id/wgoot_empty"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:fontFamily="@font/wgoot_sans"
        android:gravity="center"
        android:text="@string/wgoot_widget_empty"
        android:textColor="@color/wgoot_widget_muted"
        android:textSize="11sp"
        android:visibility="gone" />
</LinearLayout>
